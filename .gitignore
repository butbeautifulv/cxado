# Submodule working trees (managed by git submodules)
# projects/* = git submodules; shared/agent-rules, shared/skills, shared/gui = in-tree

# Large reference corpora — local only (not in git). See refs/README.md
refs/*
!refs/README.md

# Legacy manual clones (removed — use submodules / GitHub archives)
.external/
projects/fish/
projects/fstec/

# Local IDE / agent tooling (not in git — SSOT: shared/agent-rules, skills-lock + make skills-install)
.cursor/
.agents/
.codebase-memory/
.serena/

# OS / editor
.DS_Store
*.swp
.idea/

# Local env
.env
.env.*
/deploy/.secrets/*
!/deploy/.secrets/README.md
docs/architecture-site/js/credentials.js

.venv-ansible/

# Offline k3s deploy (local-only)
deploy/.local/*
!deploy/.local/README.md
deploy_logs/
deploy/ansible/k3s/inventories/**/hosts.yml
deploy/ansible/k3s/files/airgap/*
!deploy/ansible/k3s/files/airgap/.gitkeep
# Real secret manifests (keep *.example.yaml templates)
deploy/k8s/**/*-secret.yaml
!deploy/k8s/**/*-secret.example.yaml

# Python / Node artifacts inside submodules (belt-and-suspenders)
**/.venv/
**/node_modules/
**/__pycache__/

# Corp / offline infra (local-only; never push to public GitHub)
deploy/ansible/k3s/
scripts/k8s/
scripts/tunnels/
deploy/gitlab/
deploy/.secrets/
!deploy/.secrets/README.md
deploy/containers/
deploy/k8s/cxado-offline/
deploy/k8s/defectdojo-offline/
deploy/k8s/gitlab-runner/
deploy/k8s/langfuse-offline/
deploy/k8s/obs-offline/
deploy/k8s/veil-offline/
deploy/k8s/arch-docs-offline/
deploy/k8s/offline-*/
deploy/k8s/vllm-offline/
deploy/k8s/kaniko/
deploy/vllm-proxmox/
scripts/gitlab/
scripts/gpu/
docs/deploy/*k3s*
docs/deploy/*proxmox*
docs/deploy/nexus-*
docs/observability/k3s-*
*.Dockerfile.corp
Dockerfile.corp*
deploy/registry.defaults.env
