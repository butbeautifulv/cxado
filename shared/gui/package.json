{
  "name": "@cxado/gui",
  "version": "0.1.0",
  "description": "Reusable compliance/cybersec UI kit for the cxado ecosystem",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./ui/*": "./src/ui/*",
    "./shell/*": "./src/shell/*",
    "./motion": "./src/motion/index.ts",
    "./motion/*": "./src/motion/*",
    "./skeletons/*": "./src/skeletons/*",
    "./data-table": "./src/data-table/index.ts",
    "./data-table/*": "./src/data-table/*",
    "./theme/*": "./src/theme/*",
    "./hooks/*": "./src/hooks/*",
    "./utils": "./src/utils.ts",
    "./layout/*": "./src/layout/*",
    "./forms/*": "./src/forms/*",
    "./charts/*": "./src/charts/*",
    "./columns/*": "./src/columns/*",
    "./tables/*": "./src/tables/*",
    "./dashboard": "./src/dashboard/index.ts",
    "./dashboard/*": "./src/dashboard/*",
    "./lib/gui-style": "./src/lib/gui-style.ts",
    "./lib/*": "./src/lib/*",
    "./tailwind.preset.css": "./tailwind.preset.css",
    "./gui-style-profiles.css": "./gui-style-profiles.css"
  },
  "peerDependencies": {
    "@tanstack/react-table": ">=8.0.0",
    "class-variance-authority": ">=0.7.0",
    "clsx": ">=2.0.0",
    "date-fns": ">=4.0.0",
    "lucide-react": ">=1.0.0",
    "motion": ">=12.0.0",
    "next": ">=16.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "recharts": ">=3.0.0",
    "tailwind-merge": ">=3.0.0"
  },
  "scripts": {
    "rewrite-imports": "node scripts/rewrite-imports.mjs",
    "apply-gui-style-tokens": "node scripts/apply-gui-style-tokens.mjs && node scripts/apply-gui-text-tokens.mjs",
    "check-gui-style-tokens": "node scripts/check-gui-style-tokens.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.21.0",
    "motion": "^12.41.0",
    "next": "^16.2.9",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
