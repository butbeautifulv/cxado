---
# Copy to hosts.yml and fill in real IPs / SSH ports.
# WiFi direct: ansible_host=192.168.0.133 ansible_port=22
# Corp NAT hop: ansible_host=10.8.184.22 ansible_port=22012 (DNAT to node :22012)

all:
  children:
    k3s_server:
      hosts:
        p30-k44:
          ansible_host: 192.168.0.133
          ansible_port: 22
          ansible_user: bbv
          k3s_node_ip: 10.8.185.15
          k3s_tls_sans:
            - bbv-p30-k44
            - 10.8.185.15
            - 192.168.0.133
            - 127.0.0.1
    k3s_agent:
      hosts: {}
# Example worker (uncomment and adjust):
#        worker-01:
#          ansible_host: 10.8.185.16
#          ansible_port: 22
#          ansible_user: bbv
#          k3s_node_ip: 10.8.185.16
