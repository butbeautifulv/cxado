{
  "uid": "egregore-observability",
  "title": "Egregore \u2014 Logs & Traces",
  "description": "Egregore application logs and distributed traces. Metrics on cys-agi SOC; executive KPIs on CXado Overview.",
  "tags": [
    "egregore",
    "loki",
    "tempo",
    "observability",
    "production"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "graphTooltip": 1,
  "style": "dark",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "CXado Overview",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/cxado-overview",
      "keepTime": true,
      "asDropdown": false,
      "targetBlank": false
    },
    {
      "title": "cys-agi SOC",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/egregore-cys-agi",
      "keepTime": true,
      "asDropdown": false,
      "targetBlank": false
    },
    {
      "title": "SGR Reasoning",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/egregore-sgr",
      "keepTime": true,
      "asDropdown": false,
      "targetBlank": false
    },
    {
      "title": "Eval & Quality",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/egregore-eval",
      "keepTime": true,
      "asDropdown": false,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "custom",
        "label": "Namespace",
        "query": "cxado-app",
        "current": {
          "text": "cxado-app",
          "value": "cxado-app"
        },
        "options": [
          {
            "text": "cxado-app",
            "value": "cxado-app",
            "selected": true
          }
        ],
        "hide": 0
      },
      {
        "name": "service",
        "type": "custom",
        "label": "Service",
        "query": "egregore-api,egregore-worker",
        "includeAll": true,
        "allValue": "egregore-.*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "egregore-api",
            "value": "egregore-api",
            "selected": false
          },
          {
            "text": "egregore-worker",
            "value": "egregore-worker",
            "selected": false
          }
        ],
        "hide": 0
      },
      {
        "name": "correlation_id",
        "type": "textbox",
        "label": "Correlation ID",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "title": "Health",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Full scrape health on cys-agi SOC dashboard.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "#F2495C"
                },
                "1": {
                  "text": "UP",
                  "color": "#73BF69"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F2495C",
                "value": null
              },
              {
                "color": "#73BF69",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Egregore API",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"egregore-api\"}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 110,
      "title": "Logs",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Egregore application logs with optional correlation ID filter.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 21,
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "title": "Application Logs",
      "type": "logs",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"$namespace\", app=~\"$service\"} | json | correlation_id=~\"${correlation_id:pipe}.*\"",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Error-level logs only.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 22,
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "title": "Error Logs",
      "type": "logs",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"$namespace\", app=~\"$service\", level=\"error\"} | json",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "id": 120,
      "title": "Traces",
      "type": "row"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Recent Egregore distributed traces. TraceQL examples: `{span.name=\"ingress.route_and_enqueue\"}`, `{span.name=\"worker.process_job\"}`, `{span.name=\"engagement.plan\"}`.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "id": 31,
      "options": {},
      "title": "Egregore Traces",
      "type": "traces",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceqlSearch",
          "query": "{resource.service.name=~\"egregore-.*\"}",
          "limit": 20,
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Tempo distributor span ingress \u2014 indicates trace pipeline health, not Egregore-only rate.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "id": 32,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "title": "Tempo Span Ingress Rate",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(tempo_distributor_spans_received_total[$__rate_interval]))",
          "refId": "A",
          "range": true,
          "legendFormat": "spans/s"
        }
      ]
    }
  ]
}
