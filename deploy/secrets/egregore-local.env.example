# Copy to deploy/.secrets/egregore-local.env (gitignored) and fill in keys.
# Sourced automatically by cxado-up-minimal and projects/egregore/scripts/dev.sh

DEEPSEEK_API_KEY=

# Operator-only agent streaming (dev/local). Disabled in prod profiles.
STREAM_AGENT_OUTPUT=true
STREAM_AGENT_TOOLS=true

# Control plane — critic/coordinator visible in Operator UI via egress
CONTROL_MODE=inprocess

# --- 2ENV operator tunables (optional overrides; defaults in bootstrap/settings.py) ---

# API lifespan / SSE
# API_GAUGE_REFRESH_INTERVAL_S=30
# API_RECONCILE_INTERVAL_S=300
# API_RECONCILE_LEADER_TTL_S=280
# API_SSE_QUEUE_TIMEOUT_S=15
# API_SSE_RETRY_SLEEP_S=2

# HTTP client
# HTTP_CONNECT_TIMEOUT_S=10
# HTTP_READ_TIMEOUT_S=120

# Worker / reconcile
# WORKER_TRIAGE_MAX_ATTEMPTS=2
# WORKER_MAX_ATTEMPTS=3
# WORKER_MAX_DEPENDENCY_DEFERRALS=10
# WORKER_SOFT_TIMEOUT_FRACTION=0.9
# WORKER_DEQUEUE_TIMEOUT_S=2
# RECONCILE_SYNTHESIS_STALE_MULTIPLIER=2.0
# RECONCILE_SCAN_LIMIT=50

# Bus / Kafka
# BUS_SEEN_TTL_SECONDS=300
# KAFKA_CONSUME_TIMEOUT_S=1.0

# Sandbox
# K8S_SANDBOX_READY_POLL_INTERVAL_S=0.5
# DOCKER_PROBE_TIMEOUT_S=5
# DOCKER_KILL_TIMEOUT_S=10

# Tool output / egress / salvage
# TOOL_OUTPUT_PREVIEW_MAX=16384
# TOOL_STORED_OUTPUTS_MAX=5
# EGRESS_BATCH_SECONDS=0.05
# TIMEOUT_SALVAGE_SUMMARY_MAX=2000

# Follow-up limits
# FOLLOW_UP_CONVERSATION_QUERY_LIMIT=200
# FOLLOW_UP_HISTORY_LIMIT=100
# FOLLOW_UP_MERGE_QUERY_LIMIT=30
# FOLLOW_UP_MERGE_SUMMARY_MAX=400

# Budgets / critic / planner
# JOB_COST_PER_1K_TOKENS_USD=0.003
# DEFAULT_PERSONA_MAX_TOOL_CALLS=50
# PERSONA_BUDGETS_OVERRIDES_JSON={"soc":{"max_tool_calls":8}}
# CRITIC_TRUST_THRESHOLD=0.5
# CRITIC_DEFAULT_CONFIDENCE=0.5
# PLANNER_DEFAULT_POST_PROCESSORS=advisory_consultant_fallback,staged_soc_intel_for_incident

# Evidence / noop classification
# EVIDENCE_EVENT_TEXT_MAX=500
# EVIDENCE_MAX_CONFIDENCE_METADATA=0.3
# EVIDENCE_MAX_CONFIDENCE_SPARSE=0.5
# EVIDENCE_MAX_CONFIDENCE_RICH=1.0
# NOOP_LOW_CONFIDENCE_THRESHOLD=0.25
# NOOP_PENDING_TRUST_THRESHOLD=0.3

# External APIs
# WAYBACK_API_TIMEOUT_S=20

# Metrics (worker daemon / CLI)
# EGREGORE_METRICS_PORT=9091
