# Copy to deploy/.secrets/egregore-local.env (gitignored) and fill in keys.
# Sourced automatically by cxado-up-minimal and projects/egregore/scripts/dev.sh

DEEPSEEK_API_KEY=

# Operator-only agent streaming (dev/local). Disabled in prod profiles.
STREAM_AGENT_OUTPUT=true
STREAM_AGENT_TOOLS=true

# Control plane — critic/coordinator visible in ui-minimal via egress
CONTROL_MODE=inprocess
CRITIC_USE_LLM_JUDGE=true
