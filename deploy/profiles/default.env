# cxado-default profile — source in scripts or: set -a && source deploy/profiles/default.env && set +a

CXADO_NETWORK=cxado-net

# Veil graph
API_PORT=8090
MCP_HTTP_PORT=8091
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Egregore (host app)
EGREGORE_API_URL=http://localhost:8080
VEIL_API_URL=http://localhost:8090
VEIL_MCP_URL=http://localhost:8091/mcp

# Observability
PROMETHEUS_URL=http://localhost:9091
GRAFANA_URL=http://localhost:3002
TEMPO_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Postgres (egregore infra)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=egregore
