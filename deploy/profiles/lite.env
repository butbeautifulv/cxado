# cxado-lite: lower RAM/CPU than default, but keeps Qdrant + Langfuse.
# Usage: make cxado-up-lite  (docker only)
#        WORKER_REPLICAS=1 make -C projects/egregore dev

CXADO_PROFILE=lite

# Egregore app (host) — single worker instead of 4
WORKER_REPLICAS=1

# Traces off (Tempo not started in lite)
OTEL_ENABLED=false

# Langfuse LLM tracing (:3001)
CXADO_LANGFUSE=1
