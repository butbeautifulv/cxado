# Copy to cxado-k3s.env and adjust. File is gitignored.
#
# Default: direct WiFi to P30 (bbv-p30-wifi in ~/.ssh/config → 192.168.0.133:22)
# CXADO_OFFLINE_SSH_HOST=bbv-p30-wifi
# CXADO_OFFLINE_SSH_PORT=22
# CXADO_NODE_IP=192.168.0.133
#
# Corp NAT hop (when not on same WiFi LAN):
# CXADO_OFFLINE_SSH_HOST=bbv-p30-k44
# CXADO_OFFLINE_SSH_PORT=22012
# CXADO_NODE_IP=10.8.185.15
#
# CXADO_OFFLINE_SUDO_PW=
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
# NEO4J_PASSWORD=
# BUS_SIGNING_KEY=
#
# DefectDojo VM (reachable via ProxyJump bbv-p30-wifi)
# VM_01_IP=
# VM_01_USER=
# VM_01_PWD=
# VM_01_DEFECTDOJO_SU_NAME=admin
# VM_01_DEFECTDOJO_SU_PWD=
#
# GitLab (https://gitlab.svo.aero)
# GITLAB_URL=https://gitlab.svo.aero
# GITLAB_USER=
# GITLAB_PASSWORD=
