# Copy to cxado-k3s.env and adjust. File is gitignored.
#
# Default: 
# CXADO_OFFLINE_SSH_HOST=bbv-p30-wifi
# CXADO_OFFLINE_SSH_PORT=22
# CXADO_NODE_IP=192.168.0.133
#
# Corp NAT hop (when not on same WiFi LAN):
# CXADO_OFFLINE_SSH_HOST=bbv-p30-k44
# CXADO_OFFLINE_SSH_PORT=22012
# CXADO_NODE_IP=10.8.185.15
#
# Secrets for Ansible k3s bootstrap (host_vars read these via env lookup).
# CXADO_OFFLINE_SUDO_PW=   # P30 (bbv)
# VM_01_PWD=               # astradmin@vm-01
# VM_02_PWD=               # admin@vm-02
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
# NEO4J_PASSWORD=
# BUS_SIGNING_KEY=
#
# DefectDojo VM 
# VM_01_IP=
# VM_01_USER=
# VM_01_PWD=
# VM_01_DEFECTDOJO_SU_NAME=admin
# VM_01_DEFECTDOJO_SU_PWD=
#
# VM_02 
# VM_02_IP=
# VM_02_USER=
# VM_02_PWD=
#
# GitLab (corp) — https://gitlab.svo.aero/av.popov/cxado
# GITLAB_URL=https://gitlab.svo.aero
# GITLAB_USER=
# GITLAB_PASSWORD=
# GITLAB_PROJECT_ID=
# GITLAB_PROJECT_PATH=av.popov/cxado
# GITLAB_TOKEN=              # project access token (api + registry); never commit
# GITLAB_PAT_RUNNER=         # personal PAT (api + create_runner) for runner bootstrap
# GITLAB_RUNNER_TOKEN=       # glrt-... authentication token (from admin or API)
# GITLAB_RUNNER_TAGS=k3s,corp,p30
#
# Nexus (corp mirror; podman/docker registry on :8345, API/UI on :8443)
# NEXUS_DOCKER_REGISTRY=
# NEXUS_API_URL=
# NEXUS_USER=admin-SEC
# NEXUS_PASSWORD=
# NEXUS_HELM_PROXY_REPO=helm-get-proxy
# NEXUS_K3S_PROXY_REPO=k3s-releases-proxy
# NEXUS_K3S_GET_PROXY_REPO=k3s-get-proxy
# NEXUS_K3S_HOSTED_REPO=k3s-releases-hosted
# NEXUS_GITHUB_ROUTING_RULE=GitHubReleases
