# Corp artifact registries — single source of truth for cxado offline.
# Override in deploy/.secrets/cxado-k3s.env (gitignored).
# Sourced by: scripts/k8s/cxado-offline-env.sh, setup-ci-variables.sh, ansible (via env).

NEXUS_DOCKER_REGISTRY="${NEXUS_DOCKER_REGISTRY:-nexus.svo.aero:8345}"
NEXUS_DOCKER_GROUP_REGISTRY="${NEXUS_DOCKER_GROUP_REGISTRY:-nexus.svo.aero:8374}"
NEXUS_API_URL="${NEXUS_API_URL:-https://nexus.svo.aero:8443}"
NEXUS_PYPI_HOST="${NEXUS_PYPI_HOST:-nexus.svo.aero:8443}"
NEXUS_CXADO_DOCKER_REPO="${NEXUS_CXADO_DOCKER_REPO:-cxado-docker}"
NEXUS_PYPI_REPO="${NEXUS_PYPI_REPO:-srsips-pypi}"
# npm (bun) and Go module proxies — same web port as PyPI, different repo path.
# Closes the last direct-internet dependency in Kaniko builds (egregore-ui, veil-api/mcp).
NEXUS_NPM_HOST="${NEXUS_NPM_HOST:-nexus.svo.aero:8443}"
NEXUS_NPM_REPO="${NEXUS_NPM_REPO:-npm-proxy}"
NEXUS_GO_HOST="${NEXUS_GO_HOST:-nexus.svo.aero:8443}"
NEXUS_GO_REPO="${NEXUS_GO_REPO:-go-proxy}"

# Derived (do not override unless mirroring layout changes)
export NEXUS_DOCKER_REGISTRY NEXUS_DOCKER_GROUP_REGISTRY NEXUS_API_URL NEXUS_PYPI_HOST NEXUS_CXADO_DOCKER_REPO NEXUS_PYPI_REPO
export NEXUS_NPM_HOST NEXUS_NPM_REPO NEXUS_GO_HOST NEXUS_GO_REPO
export CXADO_CI_REGISTRY="${NEXUS_DOCKER_REGISTRY}/${NEXUS_CXADO_DOCKER_REPO}"
export CXADO_IMAGE_REPO="${CXADO_CI_REGISTRY}/egregore"
export CXADO_API_IMAGE_REPO="${CXADO_API_IMAGE_REPO:-${CXADO_CI_REGISTRY}/egregore-api}"
export CXADO_DISPATCHER_IMAGE_REPO="${CXADO_DISPATCHER_IMAGE_REPO:-${CXADO_CI_REGISTRY}/egregore-dispatcher}"
export CXADO_AGENT_RUNTIME_IMAGE_REPO="${CXADO_AGENT_RUNTIME_IMAGE_REPO:-${CXADO_CI_REGISTRY}/egregore-agent-runtime}"
export CXADO_TOOL_GATEWAY_IMAGE_REPO="${CXADO_TOOL_GATEWAY_IMAGE_REPO:-${CXADO_CI_REGISTRY}/egregore-tool-gateway}"
export CXADO_UI_IMAGE_REPO="${CXADO_CI_REGISTRY}/egregore-ui"
export VEIL_IMAGE_REGISTRY="${CXADO_CI_REGISTRY}/"
export VEIL_API_IMAGE_REPO="${CXADO_CI_REGISTRY}/veil-api"
export VEIL_MCP_IMAGE_REPO="${CXADO_CI_REGISTRY}/veil-mcp"
