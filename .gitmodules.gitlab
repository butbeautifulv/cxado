# GitLab-only submodule URLs — used on gitlab.svo.aero/av.popov/cxado (corp, no GitHub).
# Local dev keeps .gitmodules (GitHub). Sync: scripts/gitlab/sync-monorepo-to-gitlab.sh
# shared/* hubs are in-tree in cxado — not mirrored as separate GitLab projects.
[submodule "projects/veil"]
	path = projects/veil
	url = git@gitlab.svo.aero:av.popov/veil.git
[submodule "projects/egregore"]
	path = projects/egregore
	url = git@gitlab.svo.aero:av.popov/egregore.git
[submodule "projects/fabrica"]
	path = projects/fabrica
	url = git@gitlab.svo.aero:av.popov/fabrica.git
[submodule "projects/veneno"]
	path = projects/veneno
	url = git@gitlab.svo.aero:av.popov/veneno.git
