flowchart TB
  subgraph host [Host dev]
    API[egregore-api :8080]
    Worker[egregore-worker]
    UI[egregore-ui :3000 Next.js]
    UI -->|EGREGORE_API_UPSTREAM| API
  end

  subgraph compose [docker cxado-net minimal]
    PG[postgres]
    Redis[redis]
    LF[langfuse :3001]
    Prom[prometheus :9091]
    Graf[grafana :3002]
  end

  subgraph veil_opt [optional cxado-up-veil]
    Neo4j[neo4j]
    VAPI[veil-api]
    VMCP[veil-mcp :8091]
  end

  subgraph siem_opt [optional cxado-up-siem-mcp]
    SMCP[siem-mcp :8094]
  end

  API --> PG
  API --> Redis
  API --> LF
  Worker --> PG
  Worker --> Redis
  Worker --> LF
  Prom -->|scrape host.docker.internal:8080| API
  Graf --> Prom
  API --> VMCP
  Worker --> VMCP
  Worker --> SMCP
  VMCP --> VAPI
  VAPI --> Neo4j
