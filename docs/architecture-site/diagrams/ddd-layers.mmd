flowchart TB
  subgraph product [Product layer agents/]
    Personas[personas agent.yaml AGENT.md]
    Plans[plans routing rules]
    Skills[skills SKILL.md]
  end

  subgraph delivery [Delivery interfaces/]
    API[api/ FastAPI]
    Worker[worker/ orchestrator execution]
    Control[control_plane/ critic coordinator]
    Gateway[gateways/tool PEP]
    Ingress[ingress/ EventIngress]
  end

  subgraph bootstrap [Composition root]
    Container[bootstrap/container.py]
  end

  subgraph application [Application cys_core/application/]
    UseCases[use_cases RouteAndEnqueue StartEngagement RunWorkerJob]
    Pipeline[workers pipeline services]
    Policy[ProfilePolicyResolver]
    Ports[ports catalog orchestration observability metrics tracing]
    PlanLoader[plans/plan_loader.py]
  end

  subgraph domain [Domain cys_core/domain/]
    Catalog[catalog personas tools policy]
    Memory[memory investigation state]
    Security[security guardrails sanitizer]
    Events[events workers runs engagement]
    Pure[policy/pure lifecycle methods]
  end

  subgraph infra [Infrastructure adapters]
    Queue[queue Redis Kafka]
    Stores[memory stores job_store catalog]
    ObsAdapters[observability adapters]
    PolicyAdapters[policy adapters]
    SandboxInfra[sandbox k8s local]
  end

  subgraph runtime [Runtime Registry]
    AgentRT[AgentRuntime middleware stack]
    Registry[AgentRegistry tools]
  end

  Personas --> AgentRT
  Container --> delivery
  Container --> application
  Container --> infra
  Container --> runtime
  API --> UseCases
  Ingress --> UseCases
  Worker --> Pipeline
  UseCases --> Ports
  Ports --> infra
  Pipeline --> Ports
  UseCases --> domain
  Pipeline --> domain
  infra --> domain
  AgentRT --> Registry
  Policy --> Catalog
  PlanLoader --> Events
