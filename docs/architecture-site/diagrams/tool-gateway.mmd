flowchart LR
  subgraph worker [Worker sandbox]
    AgentRT[AgentRuntime]
    McpReg[McpToolRegistry]
  end

  subgraph pep [Tool Gateway PEP]
    Invoke[POST /invoke]
    Authz[attach-time AuthzDecision]
    Policy[policy chain depth]
    Sanitize[sanitize output]
    Audit[audit Kafka]
    Approval[HITL approval]
  end

  subgraph adapters [Adapters]
    Veil[veil_mcp ti_* playbook_*]
    SiemMcp[siem_mcp investigate_incident search_events ...]
    Veneno[veneno_mcp HITL exec]
    RagAd[rag_query ACL]
    SiemLegacy[query_siem_readonly delegates to search_events]
    Web[web_search read_document]
  end

  AgentRT --> McpReg
  McpReg --> Invoke
  Invoke --> Policy --> adapters
  adapters --> Sanitize --> Audit
  Veneno --> Approval
