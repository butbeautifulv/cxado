flowchart TB
  subgraph ingress [IngressPlane]
    API[FastAPI app.py]
    CLI[CLI egregore]
    EventIngress[EventIngress router.py]
    EngAPI[Engagements API /v1/engagements]
    BusIngress[BusIngressRouter]
  end

  subgraph app_orch [Application orchestration]
    Route[RouteAndEnqueueEvent]
    Start[StartEngagement]
    Enqueue[EnqueueWorkerJobs]
    Container[bootstrap/container.py]
  end

  subgraph control [ControlPlane]
    Critic[CriticHandler]
    Coord[CoordinatorHandler]
    Bus[SecureAgentBus HMAC trust]
    Egress[EngagementEgress SSE]
  end

  subgraph worker [WorkerPlane execution]
    Orch[WorkerOrchestrator dequeue only]
    RunJob[RunWorkerJob]
    Pipeline[context agent validator publisher finalizer]
    Kernel[AgentRunKernel]
    AgentRT[AgentRuntime]
    Sandbox[SandboxConnector]
  end

  SIEM[SIEM NetFlow Manual] --> EventIngress
  API --> EventIngress
  API --> EngAPI
  CLI --> EventIngress
  EventIngress --> Container
  EngAPI --> Container
  Container --> Route
  Container --> Start
  Route --> Enqueue
  Start --> Enqueue
  Enqueue --> Queue[(worker.jobs)]
  Bus --> BusIngress
  BusIngress --> Critic
  BusIngress --> Coord
  BusIngress --> Orch
  Queue --> Orch
  Orch --> RunJob --> Pipeline --> Kernel --> AgentRT
  RunJob --> Sandbox
  RunJob --> Bus
  RunJob --> Egress
  EngAPI --> Egress
